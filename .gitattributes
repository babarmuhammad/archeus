# Normalize line endings
* text=auto

# Force LF for Python (cross-platform)
*.py text eol=lf

# GitHub Pages reads this file as a bare hostname. autocrlf would put a carriage
# return in the built site copy, so the ending is pinned instead of left to the
# platform that happens to run the build.
docs/CNAME text eol=lf

# Force CRLF for Windows-only scripts
*.bat text eol=crlf

# Binary files — no conversion
*.ico binary
*.png binary
*.jpg binary

# Machine-written — collapse in diffs so reviewers stop reviewing generated text.
# archeus rewrites these from the semantic graph and the route tables; the
# thing to review is the generator, never its output.
.claude/rules/archeus-mem-*.md linguist-generated=true
docs/api.md linguist-generated=true
plugin/skills/** linguist-generated=true
