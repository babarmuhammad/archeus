error': error, 'output': tail, 'output_bytes': size, 'truncated': size > keep,\n1494:             'confinement': facts}\n1495: \n1496: \n1497: def _captured(out_path, keep):\n1498:     \"\"\"The output, frozen: its last *keep* bytes and its size.\"\"\"\n1499:     size = os.path.getsize(out_path)\n1500:     with open(out_path, 'rb') as f:\n1501:         f.seek(max(0, size - keep))\n1502:         return f.read(), size\n1503: \n1504: \n1505: def _staged(cmd):\n1506:     \"\"\"The stage the isolated hook command runs from: Core's `(python.exe, -I,\n1507:     hook.py)` inside one verified stage under `runtime/`. Anything else (no command,\n1508:     another shape, paths outside one stage, a stage that does not verify) refuses the\n1509:     launch before any profile is touched.\"\"\"\n1510:     if not (isinstance(cmd, tuple) and len(cmd) == 3 and cmd[1] == '-I'\n1511:             and all(isinstance(p, str) and os.path.isabs(p) for p in (cmd[0], cmd[2]))):\n1512:         raise base.SpawnFailed('isolation: the hook command is not a staged one: %r'\n1513:                                % (cmd,))\n1514:     stage = os.path.dirname(cmd[0])\n1515:     if (cmd[0], cmd[2]) != (os.path.join(stage, 'python.exe'),\n1516:                             os.path.join(stage, staging.HOOK)):\n1517:         raise base.SpawnFailed('isolation: the hook command is not one stage: %r' % (cmd,))\n1518:     try:\n1519:         return staging.verify(stage)\n1520:     except OSError as err:\n1521:         raise base.SpawnFailed('isolation: the hook runtime does not verify: %s' % err)\n1522: \n1523: \n1524: def default_plan(spec):\n1525:     \"\"\"The ��3.1 inventory as this layout can establish it today �?" the production shape.\n1526: \n1527:     It is deliberately *not* satisfiable yet: no R3-B broker holds the provider-access\n1528:     row, and nothing grants the runtime and hook rows, so ��3.4's condition 2 stays unmet\n1529:     and an isolated production execution never starts �?" with no setting that changes\n1530:     it (S1 gate ��3: \"the invariant check must test all six conditions including the\n1531:     later-slice boundaries\"). The class 1�?"3 directories are the ones `base.spawn`\n1532:     creates (��7.5), and the execution's own directory around them is Core's. A\n1533:     synthetic fixture supplies its own plan and satisfies the conditions in the fixture.\n1534:     \"\"\"\n1535:     paths = ExecPaths(spec.execution_id)\n1536:     stage = _staged(spec.hook_settings)\n1537:     # planned rows only: nothing here applies any of them. The runtime and hook rows\n1538:     # name Core's verified stage (C4b), never the real Python install or this\n1539:     # repository, which no grant may ever touch (one did, 2026-10-08)\n1540:     grants = (Grant(spec.workdir, 'rw', 'workspace'),\n1541:               Grant(stage, 'rx', 'runtime'),\n1542:               Grant(stage, 'rx', 'hook'),\n1543:               Grant(paths.req, 'rw', 'request'),\n1544:               Grant(paths.res, 'rx', 'response'),\n1545:               Grant(paths.ctl, 'rx', 'sentinel'),\n1546:               Grant(paths.state, 'rw', 'state'))\n1547:     return IsolationRequest(execution_id=spec.execution_id, workspace=spec.workdir,\n1548:                             grants=grants, mailbox=paths.req, response=paths.res,\n1549:                             sentinel=paths.ctl,\n1550:                             spawn_config=os.path.join(paths.res, 'settings.json'),\n1551:                             state_dir=paths.state, core_state=run_dir(),\n1552:                             core_only=(paths.dir,), broker='')\n1553: \n1554: \n1555: class IsolationContext:\n1556:     \"\"\"What rides on the `ExecutionSpec` into `base.spawn`: the isolated launch itself.\n1557:     Its presence, not a flag, is what selects the isolated path, and its failure is\n1558:     `SpawnFailed` �?" never a second attempt through the detached launcher.\"\"\"\n1559: \n1560:     def __init__(self, authority, request):\n"}],"isError":false,"timestamp":1792409100117}}
