aken starts nothing, never unisolated.\n230:         try:\n231:             iso = getattr(self.node, 'isolation', None)\n232:             isolated = bool(iso is not None and iso.requested(e.id, adapter))\n233:         except Exception as err:\n234:             self._do(X.refuse, execution_id=e.id, stop_reason='binding',\n235:                      reason='the isolation decision could not be taken: %s'\n236:                      % type(err).__name__)\n237:             return True\n238:         hook = (sys.executable, HOOK)\n239:         if isolated:\n240:             # C4b (T-034): the isolated hook runs from Core's verified copy of the real\n241:             # install (base_prefix, never a venv launcher's directory), verified again on\n242:             # every process, a resume's included. No copy, no start: never Core's own\n243:             try:\n244:                 stage = staging.stage(sys.base_prefix, HOOK)\n245:             except OSError as err:\n246:                 self._do(X.refuse, execution_id=e.id, stop_reason='binding',\n247:                          reason='the hook runtime could not be staged: %s' % err)\n248:                 return True\n249:             hook = (os.path.join(stage, 'python.exe'), '-I', os.path.join(stage, staging.HOOK))\n250:         try:\n251:             workdir, branch = self._workspace(e, m, t, isolated=isolated)\n252:         except PathTooLong as err:\n253:             self._do(X.refuse, execution_id=e.id, reason='no workspace: %s' % err,\n254:                      stop_reason='path_too_long', missions=self.missions)\n255:             return True\n256:         except OSError as err:\n257:             self._do(X.refuse, execution_id=e.id, reason='no workspace: %s' % err,\n258:                      stop_reason='workspace')\n259:             return True\n260:         token = 'hook_' + secrets.token_urlsafe(32)\n261:         seq = e.process_seq + 1\n262:         # a harness's default account runs on the home its decision recorded\