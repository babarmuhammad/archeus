on, 'charged': stop_reason not in UNCHARGED,\n196:               'ended_at': _now_iso(),\n197:               'hook_token_hash': None}\n198:     if e.state == 'INTENT':\n199:         e = _fire(tx, e.id, 'spawn_failed', actor, reason,\n200:                   dict(fields, exit_reason='abandoned'))\n201:     else:\n202:         e = _fire(tx, e.id, 'discarded', actor, reason, dict(fields, exit_reason='killed'))\n203:         # the session is Core's record of what ran, whoever ends the execution: a user's\n204:         # stop or e-stop of a halted one ends it from their own command (T-101). Only\n205:         # here: every other end is Core recording what it observed, and keeps its guard\n206:         e = _finish(tx, actor, e, facts, session_actor=(\n207:             actor if actor.kind == 'system'\n208:             else Ref('system', queries.system_principal(tx.conn))))\n209:         _event(tx, 'execution.ended', e, actor, _end_payload(e))\n210:     out = _respond(tx, actor, e, reason, failure_class)\n211:     if stop_reason in BLOCKING:\n212:         _block(tx, actor, missions, e.mission_id, reason)\n213:     return out\n214: \n215: \n=== charged_attempts / max_attempts ===\n66:     return row.entity\n67: \n68: \n69: def charged_attempts(tx, task_id):\n70:     \"\"\"How many of a task's executions spent an attempt (D9).\"\"\"\n71:     return sum(1 for r in tx.where(entities.Execution, task_id=task_id)\n72:                if r.entity.charged is not False)\n73: \n74: \nb73f875:archeus/core/application/commands.py:217:                        max_attempts=t.max_attempts, failure_class=t.failure_class,\nb73f875:archeus/core/application/executions.py:494:    if used < t.max_attempts:\nb73f875:archeus/core/domain/entities.py:892:    _MIN1 = ('max_attempts', 'estimate')\nb73f875:archeus/core/domain/entities.py:895:               'action_classes', 'max_attempts', 'objective', 'expected_output',\nb73f875:archeus/core/domain/entities.py:906:    max_attempts: int = 2\nb73f875:arche