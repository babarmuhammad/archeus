3:         line = {'op': 'spawn', 'execution_id': spec.execution_id,\n174:                 'process_seq': spec.process_seq, 'pid': handle.pid,\n175:                 'create_time': handle.create_time, 'argv0': adapter.id,\n176:                 'started_at': time.time()}\n177:         if spec.isolation is not None:\n178:             line.update(spec.isolation.facts())\n179:         self._registry(line)\n180:         return handle\n181: \n182:     def _isolate(self, spec):\n183:         \"\"\"The isolated launch for one execution's process, riding on the spec into\n184:         `base.spawn` (��3.4: the new mechanism behind the existing seam). The plan is\n185:         Core's, never the adapter's.\"\"\"\n=== isolation.py note_failure + establish head ===\n780:                             core_state=r.core_state, core_only=r.core_only,\n781:                             broker=r.broker)\n782: \n783:     def note_failure(self, spec, err):\n784:         \"\"\"The registry's word for a spawn that never happened (��3.7, O7's\n785:         reconcilable state): an isolated execution's failure is recorded as\n786:         `isolation_failed` with its reason, so the record, the tombstone and the\n787:         registry agree on it across a restart. A non-isolated spawn is untouched.\"\"\"\n788:         if getattr(spec, 'isolation', None) is None:\n789:             return\n790:         try:\n791:             rec = self.record(spec.execution_id)\n792:             if rec is None or rec.state not in ('failed', 'quarantined'):\n793:                 self._note({'op': 'isolation_failed', 'execution_id': spec.execution_id,\n794:                             'state': 'isolation_failed',\n795:                             'reason': (rec.reason if rec else 'unknown') or str(err)})\n796:         except OSError:\n797:             # the registry is the instrument (item 83): a line it cannot take never\n798:             # replaces the spawn failure the caller raises next, and the record holds it\n799:             pass\n800: \n801:     def establish(self, request, paths=None):\n802:         \"\"\"The ��3.4 invariant, established: identity, grants, Job. Raises\n803:         `IsolationUnavailable` when any of the six conditions does not hold, and\n804:         records which ones did not. A write that fails (`OSError`: the record, a\n805:         quarantine line, a registry note) is an establishment failure like any other:\n806:         nothing starts, and what is on disk decides what cleanup may do.\"\"\"\n807:         api = self.boundary\n808:         if request.kind == 'verify':\n809:             if request.execution_id in self._admitted:\n810:                 self._admitted.discard(request.execution_id)     # admitted by run_confined\n811:             else:\n812:                 _admit(request.execution_id)\n813:         prior = self.record(request.execution_id)\n814:         if prior is not None and prior.state == 'invalid':\n815:             # a record exists and cannot be trusted: nothing is created for this\n"}],"isError":false,"timestamp":1792409143641}}
