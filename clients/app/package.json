{
  "name": "archeus-app",
  "private": true,
  "version": "0.0.0",
  "description": "The Archeus V1 client (P16: Now, Work, World, Attention, Control). Built into archeus/api/static; Node is a build-time dependency only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --experimental-strip-types --no-warnings --test \"test/*.test.ts\""
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
